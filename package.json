{
  "name": "flipgpu",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time 3D PIC/FLIP and PBF fluid simulation in the browser with WebGPU compute.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "capture:gif": "node scripts/capture_gif.mjs --out docs/media/dam-break.gif",
    "banner": "vite-node scripts/make_banner.ts"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.40",
    "gifenc": "^1.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
